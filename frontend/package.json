{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/helpers/register-alias.mjs --test tests/unit/*.test.mjs tests/integration/*.test.mjs && vitest run --passWithNoTests",
    "test:unit": "node --import ./tests/helpers/register-alias.mjs --test tests/unit/*.test.mjs && vitest run tests/unit --passWithNoTests",
    "test:integration": "node --import ./tests/helpers/register-alias.mjs --test tests/integration/*.test.mjs && vitest run tests/integration --passWithNoTests",
    "test:components": "vitest run"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "vitest": "^3.2.7"
  }
}

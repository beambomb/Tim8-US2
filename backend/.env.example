PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/carikos
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
CORS_ORIGIN=http://localhost:3000

# Cloudinary (wajib untuk upload foto kos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin (wajib diset di production saat menjalankan npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti_password_admin
ADMIN_NAME=Administrator
ADMIN_PHONE=081111222333

# Email notifikasi gratis (pilih Brevo HTTPS API untuk Hugging Face Spaces / cloud)
BREVO_API_KEY=
BREVO_SENDER_EMAIL="CariKos <emailterverifikasi@domainmu.com>"

# Atau via SMTP gratis (Brevo SMTP / Gmail App Password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CariKos <noreply@carikos.local>"
